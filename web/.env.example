# Copy to .env.local and fill in. Never commit real values.
# VITE_ values are exposed to the browser; keep server-only keys without the prefix.
VITE_MATTERPORT_SDK_KEY=
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
VEXCEL_API_KEY=
# Optional server-only key with Routes API and Street View Static API enabled.
GOOGLE_MAPS_API_KEY=
